{
  "name": "obsidian-longhand",
  "version": "0.0.1",
  "description": "Obsidian plugin to transcribe images with an OpenAI-compatible vision model.",
  "main": "main.js",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --outfile=main.js --external:obsidian --format=cjs --target=es2020 --platform=browser --sourcemap",
    "build": "esbuild src/main.ts --bundle --minify --outfile=main.js --external:obsidian --format=cjs --target=es2020 --platform=browser",
    "release": "node scripts/release.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.12",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@lezer/markdown": "^1.8.0",
    "openai": "^4.56.0",
    "heic2any": "^0.0.3"
  }
}
